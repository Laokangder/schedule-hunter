# ========== 必填：API Key 配置 ==========
# 蓝心大模型 API Key（必填）
BLUELM_API_KEY=your_bluelm_api_key_here

# 通用 LLM API Key（可选，若与 BLUELM_API_KEY 相同可省略）
LLM_API_KEY=your_llm_api_key_here

# ========== 可选：服务配置 ==========
# 服务地址和端口
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库路径（可选，默认使用 SQLite）
DATABASE_URL=sqlite:///./schedule.db

# CORS 配置（可选，默认允许所有）
CORS_ORIGINS=*

# 日志级别（可选，默认 INFO）
LOG_LEVEL=INFO
